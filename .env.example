# Copy to .env with `pnpm env:setup`, which also fills in random secrets.

# --- Postgres ---
POSTGRES_USER=hitl
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hitl
DATABASE_URL=postgres://hitl:change-me@localhost:5432/hitl

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Web ---
# Public URL of the portal, used in alert emails.
APP_URL=http://localhost:3000
# Secret mixed into session and device-key hashes. Keep it long and random.
AUTH_SECRET=change-me

# --- ML service ---
ML_URL=http://localhost:8000
# Shared secret between web and ml.
ML_TOKEN=change-me
# Votes needed before the model trains, and the centre of the fallback estimate.
ML_MIN_TRAINING_ROWS=30
ML_HEURISTIC_SETPOINT_C=24.5

# --- Comfort thresholds (tropical defaults) ---
COMFORT_TEMP_MIN_C=23
COMFORT_TEMP_MAX_C=26
COMFORT_HUMIDITY_MIN_PCT=40
COMFORT_HUMIDITY_MAX_PCT=70
# CO2 (ppm): advise more ventilation above WARN, open an alert above HIGH.
CO2_WARN_PPM=1000
CO2_HIGH_PPM=1500

# Time zone for display and the model's hour-of-day feature.
TZ_DISPLAY=Asia/Kuala_Lumpur

# --- Data retention ---
READINGS_RETENTION_DAYS=180

# --- Alerts ---
# Open alerts nobody acknowledged within this many minutes are escalated and emailed again.
ALERT_ESCALATE_AFTER_MIN=5

# --- Alert email (optional, leave SMTP_HOST empty to turn off) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- One-off import from the old MongoDB (optional) ---
LEGACY_MONGODB_URI=
LEGACY_MONGODB_DB=hitl_smart_building
